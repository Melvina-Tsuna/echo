NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Notifications push (optionnel — l'app fonctionne sans, /api/notify
# répond juste "skipped" si absent). Génère une paire avec :
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Clé de service Supabase (Project Settings -> API -> service_role).
# SECRÈTE : ne jamais exposer côté client, ne jamais committer une vraie
# valeur. Nécessaire à /api/notify pour retrouver les abonnements des
# parents concernés (contourne RLS, usage serveur uniquement).
SUPABASE_SERVICE_ROLE_KEY=
